# --- Stage 1: Build the Node app ---
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm and dependencies
COPY package*.json pnpm-lock.yaml* ./
RUN npm install -g pnpm && pnpm install

# Copy source and build
COPY . .
RUN pnpm run build


# --- Stage 2: Run with Nginx ---
FROM nginx:alpine

# Copy built app
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY package*.json pnpm-lock.yaml* ./

# Install Node to run backend
RUN apk add --no-cache nodejs npm
RUN npm install -g pnpm && pnpm install --prod

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose only Nginx port (Node listens internally on 3000)
EXPOSE 80

# Start both Node.js and Nginx
# CMD node dist/index.js & nginx -g 'daemon off;'
CMD ["sh", "-c", "node dist/index.js & nginx -g 'daemon off;'"]
